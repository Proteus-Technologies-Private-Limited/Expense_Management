  "SOURCE_SQL": "SELECT r.employee AS EMPLOYEE, r.status AS STATUS, COUNT(*) AS REPORT_COUNT FROM exptrack_expense_report r WHERE r.approver = ?.@LoginUser AND r.status IN ('Submitted','Approved','Rejected') AND r.report_date BETWEEN ?.from_date AND ?.to_date AND r.employee LIKE ?.employee GROUP BY r.employee, r.status ORDER BY r.employee"
}
