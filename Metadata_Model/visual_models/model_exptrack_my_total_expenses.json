  "SOURCE_SQL": "SELECT DATE_TRUNC('month', e.expense_date)::date AS MONTH_START, SUM(e.amount) AS MONTH_TOTAL, 'My Total Expenses (last 6 months)' AS LBL_TOTAL FROM exptrack_expense e WHERE e.employee = ?.@LoginUser AND e.expense_date >= DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '5 months' GROUP BY DATE_TRUNC('month', e.expense_date) ORDER BY MONTH_START"
}
