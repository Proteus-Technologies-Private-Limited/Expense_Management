  "SOURCE_SQL": "SELECT r.report_id AS REPORT_ID, r.report_title AS REPORT_TITLE, r.employee AS EMPLOYEE, r.status AS STATUS, r.total_amount AS TOTAL_AMOUNT, r.approval_date AS APPROVAL_DATE, r.approver AS APPROVER, r.approver_comments AS APPROVER_COMMENTS, e.payment_process_status AS PAYMENT_PROCESS_STATUS FROM exptrack_expense_report r JOIN exptrack_expense e ON r.expense_id = e.expense_id WHERE r.status IN ?.status AND r.approval_date::date >= ?.from_date AND r.approval_date::date <= ?.to_date ORDER BY r.approval_date DESC"
}