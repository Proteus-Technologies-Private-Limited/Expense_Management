  "SOURCE_SQL": "SELECT COUNT(*) AS TOTAL_ACTIVITIES, 'Total Activities' AS LBL_TOTAL FROM ( SELECT e.add_date::date AS act_date, 'Added' AS activity_type, e.expense_id AS activity_details, (e.employee || ' added Expense ' || e.expense_id) AS description FROM exptrack_expense e WHERE e.add_date IS NOT NULL UNION ALL SELECT e.chg_date::date, 'Updated', e.expense_id, (e.employee || ' updated Expense ' || e.expense_id) FROM exptrack_expense e WHERE e.chg_date IS NOT NULL AND (e.add_date IS NULL OR e.chg_date::date <> e.add_date::date) UNION ALL SELECT r.add_date::date, 'Added', r.report_id, (r.employee || ' added Report ' || r.report_id) FROM exptrack_expense_report r WHERE r.add_date IS NOT NULL UNION ALL SELECT r.approval_date::date, 'Approved', r.report_id, (COALESCE(r.approver, 'Approver') || ' approved Report ' || r.report_id) FROM exptrack_expense_report r WHERE r.status = 'Approved' AND r.approval_date IS NOT NULL UNION ALL SELECT r.approval_date::date, 'Rejected', r.report_id, (COALESCE(r.approver, 'Approver') || ' rejected Report ' || r.report_id) FROM exptrack_expense_report r WHERE r.status = 'Rejected' AND r.approval_date IS NOT NULL ) act WHERE act.act_date BETWEEN ?.from_date AND ?.to_date"
