  "SOURCE_SQL": "SELECT c.category_name AS CATEGORY_NAME, COUNT(e.expense_id) AS TXN_COUNT FROM exptrack_expense e JOIN exptrack_expense_category c ON e.category = c.category_code WHERE e.expense_date >= ?.from_date AND e.expense_date <= ?.to_date GROUP BY c.category_name ORDER BY c.category_name"
}
