  "SOURCE_SQL": "SELECT r.report_id AS REPORT_ID, r.employee AS EMPLOYEE, r.total_amount AS TOTAL_AMOUNT, r.report_date AS REPORT_DATE FROM exptrack_expense_report r WHERE r.approver = ?.@LoginUser AND r.status = 'Submitted' AND r.employee LIKE ?.employee ORDER BY r.report_date"
}
