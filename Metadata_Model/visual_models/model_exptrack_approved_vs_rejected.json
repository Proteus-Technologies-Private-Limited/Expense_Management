  "SOURCE_SQL": "SELECT r.status AS STATUS, COUNT(*) AS REPORT_COUNT FROM exptrack_expense_report r WHERE r.employee = ?.@LoginUser AND r.status IN ('Approved','Rejected') AND r.approval_date IS NOT NULL AND r.approval_date::date BETWEEN ?.from_date AND ?.to_date AND COALESCE(r.trip,'') LIKE ?.trip_id GROUP BY r.status"
}
