  "SOURCE_SQL": "SELECT act.act_date AS ACT_DATE, COUNT(*) AS ACTIVITY_COUNT FROM ( SELECT e.add_date::date AS act_date FROM exptrack_expense e WHERE e.add_date IS NOT NULL UNION ALL SELECT e.chg_date::date FROM exptrack_expense e WHERE e.chg_date IS NOT NULL AND (e.add_date IS NULL OR e.chg_date::date <> e.add_date::date) UNION ALL SELECT r.add_date::date FROM exptrack_expense_report r WHERE r.add_date IS NOT NULL UNION ALL SELECT r.approval_date::date FROM exptrack_expense_report r WHERE r.status = 'Approved' AND r.approval_date IS NOT NULL UNION ALL SELECT r.approval_date::date FROM exptrack_expense_report r WHERE r.status = 'Rejected' AND r.approval_date IS NOT NULL ) act WHERE act.act_date BETWEEN ?.from_date AND ?.to_date GROUP BY act.act_date ORDER BY act.act_date"
