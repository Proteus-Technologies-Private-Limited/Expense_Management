  "SOURCE_SQL": "SELECT DATE_TRUNC('month', e.expense_date)::date AS EXPENSE_MONTH, SUM(e.amount) AS MONTH_AMOUNT FROM exptrack_expense e WHERE e.employee = ?.@LoginUser AND e.expense_date BETWEEN ?.from_date AND ?.to_date AND COALESCE(e.trip,'') LIKE ?.trip_id GROUP BY DATE_TRUNC('month', e.expense_date) ORDER BY EXPENSE_MONTH"
