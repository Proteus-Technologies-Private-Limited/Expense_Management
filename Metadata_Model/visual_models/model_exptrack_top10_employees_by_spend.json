  "SOURCE_SQL": "SELECT r.employee AS EMPLOYEE, SUM(r.total_amount) AS TOTAL_AMOUNT, COUNT(*) AS REPORT_COUNT FROM exptrack_expense_report r WHERE r.status = 'Approved' AND r.approval_date IS NOT NULL AND r.approval_date::date BETWEEN ?.from_date AND ?.to_date GROUP BY r.employee ORDER BY TOTAL_AMOUNT DESC LIMIT 10"
}
