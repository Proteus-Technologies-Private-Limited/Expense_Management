  "SOURCE_SQL": "SELECT pm.payment_method_name AS PAYMENT_METHOD_NAME, SUM(e.amount) AS TOTAL_AMOUNT FROM exptrack_expense e JOIN exptrack_payment_method pm ON e.payment_method = pm.payment_method_code WHERE e.expense_date >= ?.from_date AND e.expense_date <= ?.to_date GROUP BY pm.payment_method_name ORDER BY pm.payment_method_name"
}
