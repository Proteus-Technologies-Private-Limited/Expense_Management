  "SOURCE_SQL": "SELECT pm.payment_method_name AS PAYMENT_METHOD_NAME, SUM(e.amount) AS PAYMENT_AMOUNT FROM exptrack_expense e JOIN exptrack_expense_report r ON r.report_id = e.expense_report LEFT JOIN exptrack_payment_method pm ON pm.payment_method_code = e.payment_method LEFT JOIN exptrack_expense_category c ON c.category_code = e.category WHERE r.status = 'Approved' AND e.expense_date BETWEEN ?.from_date AND ?.to_date AND COALESCE(c.category_name, e.category) LIKE ?.category_name GROUP BY pm.payment_method_name ORDER BY PAYMENT_AMOUNT DESC"
}
