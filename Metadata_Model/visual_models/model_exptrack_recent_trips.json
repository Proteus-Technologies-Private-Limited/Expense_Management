  "SOURCE_SQL": "SELECT t.trip_id AS TRIP_ID, t.trip_name AS TRIP_NAME, t.start_date AS START_DATE, t.end_date AS END_DATE, t.total_expense_amount AS TOTAL_EXPENSE_AMOUNT, t.status AS STATUS FROM exptrack_trip t WHERE t.employee = ?.@LoginUser AND t.trip_id LIKE ?.trip_id ORDER BY t.start_date DESC LIMIT 10"
}
