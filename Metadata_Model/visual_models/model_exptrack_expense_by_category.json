  "SOURCE_SQL": "SELECT COALESCE(c.category_name, e.category) AS CATEGORY_NAME, SUM(e.amount) AS CATEGORY_AMOUNT FROM exptrack_expense e LEFT JOIN exptrack_expense_category c ON c.category_code = e.category WHERE e.employee = ?.@LoginUser AND e.expense_date BETWEEN ?.from_date AND ?.to_date AND COALESCE(e.trip,'') LIKE ?.trip_id GROUP BY COALESCE(c.category_name, e.category) ORDER BY CATEGORY_AMOUNT DESC"
}
