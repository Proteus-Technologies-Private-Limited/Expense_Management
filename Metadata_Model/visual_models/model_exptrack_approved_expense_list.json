  "SOURCE_SQL": "SELECT e.expense_id AS EXPENSE_ID, e.expense_date AS EXPENSE_DATE, e.employee AS EMPLOYEE, COALESCE(c.category_name, e.category) AS CATEGORY_NAME, e.amount AS AMOUNT FROM exptrack_expense e JOIN exptrack_expense_report r ON r.report_id = e.expense_report LEFT JOIN exptrack_expense_category c ON c.category_code = e.category WHERE r.status = 'Approved' AND e.expense_date BETWEEN ?.from_date AND ?.to_date AND COALESCE(c.category_name, e.category) LIKE ?.category_name ORDER BY e.expense_date DESC"
}
