  "SOURCE_SQL": "SELECT DATE_TRUNC('month', e.expense_date)::date AS MONTH_START, SUM(e.amount) AS TOTAL_AMOUNT FROM exptrack_expense e WHERE e.expense_date >= ?.from_date AND e.expense_date <= ?.to_date GROUP BY DATE_TRUNC('month', e.expense_date)::date ORDER BY MONTH_START"
}
