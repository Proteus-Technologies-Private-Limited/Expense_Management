  "SOURCE_SQL": "SELECT DATE_TRUNC('month', r.approval_date)::date AS DECISION_MONTH, AVG(EXTRACT(EPOCH FROM (r.approval_date - r.report_date::timestamp)) / 86400.0) AS AVG_TURNAROUND_DAYS FROM exptrack_expense_report r WHERE r.approver = ?.@LoginUser AND r.status IN ('Approved','Rejected') AND r.approval_date IS NOT NULL AND r.approval_date::date BETWEEN ?.from_date AND ?.to_date AND r.employee LIKE ?.employee GROUP BY DATE_TRUNC('month', r.approval_date) ORDER BY DECISION_MONTH"
}
