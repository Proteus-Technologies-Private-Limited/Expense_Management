  "SOURCE_SQL": "SELECT COALESCE(SUM(er.total_amount), 0) AS TOTAL_AMOUNT, 'Total Expense Report Amount' AS LBL_TOTAL_AMOUNT FROM exptrack_expense e JOIN exptrack_expense_report er ON e.expense_report = er.report_id"
