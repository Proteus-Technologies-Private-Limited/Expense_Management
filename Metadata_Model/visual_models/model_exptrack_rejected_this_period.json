  "SOURCE_SQL": "SELECT COUNT(*) AS REJECTED_COUNT, 'Rejected This Period' AS LBL_REJECTED FROM exptrack_expense_report r WHERE r.approver = ?.@LoginUser AND r.status = 'Rejected' AND r.approval_date IS NOT NULL AND r.approval_date::date BETWEEN ?.from_date AND ?.to_date AND r.employee LIKE ?.employee"
}
