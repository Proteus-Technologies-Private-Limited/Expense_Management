  "SOURCE_SQL": "SELECT ec.category_name AS CATEGORY_NAME, COUNT(e.expense_id) AS EXPENSE_COUNT FROM exptrack_expense e JOIN exptrack_expense_category ec ON e.category = ec.category_code GROUP BY ec.category_name"
