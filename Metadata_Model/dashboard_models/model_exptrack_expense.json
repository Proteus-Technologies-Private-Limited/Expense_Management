{
  "DASHBOARD": {
    "DASHBOARD_ID": "EXPTRACK_EXPENSE",
    "DASHBOARD_TYPE": "S",
    "DASHBOARD_NAME": "Approval Activity Log",
    "DASHBOARD_DESCR": "Org-wide read-only audit trail of approve/reject decisions on expense reports, with headline approval KPIs and turnaround trend.",
    "CREATED_BY": "admin",
    "CREATED_DATE": "2026-09-10",
    "REFRESH_INTERVAL_SECONDS": 0,
    "GLOBAL_CRITERIA": [
      {
        "PARAM_NAME": "FROM_DATE",
        "PROMPT_LABEL": "From Date",
        "DEFAULT_VALUE": ":calendar_year_start",
        "DATA_TYPE": "date",
        "OPERATOR": ">=",
        "BROADCAST_TO": [
          "VIS_REPORTS_APPROVED",
          "VIS_TOTAL_APPROVED_AMOUNT",
          "VIS_TURNAROUND_TREND",
          "VIS_APPROVAL_ACTIVITY_LOG"
        ]
      },
      {
        "PARAM_NAME": "TO_DATE",
        "PROMPT_LABEL": "To Date",
        "DEFAULT_VALUE": ":calendar_today",
        "DATA_TYPE": "date",
        "OPERATOR": "<=",
        "BROADCAST_TO": [
          "VIS_REPORTS_APPROVED",
          "VIS_TOTAL_APPROVED_AMOUNT",
          "VIS_TURNAROUND_TREND",
          "VIS_APPROVAL_ACTIVITY_LOG"
        ]
      },
      {
        "PARAM_NAME": "EMPLOYEE",
        "PROMPT_LABEL": "Approver",
        "DEFAULT_VALUE": "%",
        "DATA_TYPE": "string",
        "OPERATOR": "like",
        "BROADCAST_TO": [
          "VIS_TURNAROUND_TREND"
        ]
      }
    ],
    "VISUALS": [
