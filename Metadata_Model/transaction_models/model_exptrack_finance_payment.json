            {
              "column": {
                "name": "PAYMENT_STATUS",
                "db_name": "PAYMENT_STATUS",
                "table_name": "EXPTRACK_EXPENSE_REPORT",
                "group_name": "Payment",
                "col_type": "VARCHAR",
                "heading": "Payment Status",
                "descr": "Pending until Finance processes payment; set to Paid by the Process Payment action",
                "mandatory": true,
                "default_value": "Pending",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Pending",
                      "display": "Pending"
                    },
                    {
                      "data": "Paid",
                      "display": "Paid"
                    }
                  ]
                },
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "PAYMENT_REFERENCE",
                      "expr": "iif({form.PAYMENT_STATUS} == \"Pending\", \"\", {form.PAYMENT_REFERENCE})"
                    }
                  ],
                  "protect": [
                    {
                      "form_col": "PAYMENT_REFERENCE",
                      "when": "{form.PAYMENT_STATUS} == \"Pending\""
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Paid",
                      "color": "green",
                      "icon": "\u2713",
                      "label": "Paid"
                    },
                    {
                      "when": "Pending",
                      "color": "amber",
                      "icon": "\u25f7",
                      "label": "Pending"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "x": "80",
                "y": "80",
                "col_id": "8",
                "table_display_name": "Expense report - payment is recorded against this row",
