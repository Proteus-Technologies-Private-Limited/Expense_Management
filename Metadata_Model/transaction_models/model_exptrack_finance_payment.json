            "extra_filters": [
              {
                "column": "STATUS",
                "op": "=",
                "value": "Approved"
              }
            ],
            "columns": [
              "REPORT_ID",
              "REPORT_TITLE",
              "EMPLOYEE",
              "TOTAL_AMOUNT",
              "APPROVAL_DATE",
              "PAYMENT_STATUS",
              "PAYMENT_DATE",
              "PAYMENT_REFERENCE"
            ]
          },
          "validations": [
            {
              "type": "expression",
              "name": "Only approved reports",
              "error_code": "PAY_NOT_APPROVED",
              "message": "Only manager-approved reports can be processed for payment (report {form.REPORT_ID} is {form.STATUS}).",
              "expression": "{form.STATUS} == \"Approved\""
            },
            {
              "type": "expression",
              "name": "Reference mandatory on payment",
              "error_code": "PAY_REF_MANDATORY",
              "message": "Enter the Payment Reference before marking report {form.REPORT_ID} as Paid.",
              "expression": "{form.PAYMENT_STATUS} != \"Paid\" or not_empty({form.PAYMENT_REFERENCE})"
            }
          ],
          "actions": [
            {
              "name": "Process Payment",
              "handler": "message",
              "scope": "row",
              "visible_when": "{form.STATUS} == \"Approved\" and {form.PAYMENT_STATUS} != \"Paid\"",
              "business_logic": {
                "method": "process_payment",
                "description": "Record payment on the approved expense report",
                "spec": "Input payload is the clicked EXPTRACK_EXPENSE_REPORT row (flat). Refuse with {\"error\": ...} when STATUS <> 'Approved', when PAYMENT_STATUS is already 'Paid', or when PAYMENT_REFERENCE is empty/blank. Otherwise UPDATE EXPTRACK_EXPENSE_REPORT SET PAYMENT_STATUS = 'Paid', PAYMENT_DATE = current date (the processing date), PAYMENT_REFERENCE = the reference entered on the form, CHG_DATE = current timestamp, CHG_USER = the acting user WHERE REPORT_ID = the payload REPORT_ID AND STATUS = 'Approved' AND PAYMENT_STATUS <> 'Paid'. If no row was updated (someone else paid it meanwhile), return {\"error\": \"Report <id> has already been paid.\"}. On success return {\"message\": \"Payment processed for report <REPORT_ID>, reference <PAYMENT_REFERENCE>.\"}."
              },
              "confirmation": {
                "mode": "reconfirm",
                "message": "Process payment of {form.TOTAL_AMOUNT} for report {form.REPORT_ID} ({form.EMPLOYEE})?"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Report must be approved",
                  "error_code": "PP_NOT_APPROVED",
                  "message": "Only reports with STATUS = Approved can be paid (report {form.REPORT_ID} is {form.STATUS}).",
                  "expression": "{form.STATUS} == \"Approved\""
                },
                {
                  "type": "expression",
                  "name": "Not already paid",
                  "error_code": "PP_ALREADY_PAID",
                  "message": "Report {form.REPORT_ID} is already marked Paid.",
                  "expression": "{form.PAYMENT_STATUS} != \"Paid\""
                },
                {
                  "type": "expression",
                  "name": "Payment reference entered",
                  "error_code": "PP_REF_REQ",
                  "message": "Enter the Payment Reference before processing payment.",
                  "expression": "not_empty({form.PAYMENT_REFERENCE})"
                }
              ]
            }
          ]
        }
      }
