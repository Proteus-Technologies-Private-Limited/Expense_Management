            {
              "name": "View Receipt",
              "handler": "html_modal",
              "scope": "row",
              "business_logic": {
                "method": "view_expense_receipt",
                "description": "Open the receipt of the selected expense line",
                "spec": "Payload is the selected EXPTRACK_EXPENSE row (flat). Read RECEIPT_ATTACHMENT for the row identified by EXPENSE_REPORT + EXPENSE_ID. If it is blank, return {'html': '<p>No receipt attached for this expense line.</p>'}. Otherwise return {'html': ...} embedding the stored file URL - an <img> tag when the URL ends in an image extension (.png/.jpg/.jpeg/.gif/.webp), otherwise an <iframe> plus a direct 'Open in new tab' anchor. Read-only: never modify any row."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Receipt present",
                  "error_code": "NO_RECEIPT",
                  "message": "No receipt is attached to expense {form.EXPENSE_ID}.",
                  "expression": "not_empty({form.RECEIPT_ATTACHMENT})"
                }
              ]
            }
          ]
        }
      }
    ],
    "actions": [
      {
        "name": "Approve",
        "handler": "message",
        "scope": "row",
        "visible_when": "in_list({form.STATUS}, \"Submitted,Pending\")",
        "business_logic": {
          "method": "approve_expense_report",
          "description": "Approve the submitted expense report",
          "spec": "Payload is the EXPTRACK_EXPENSE_REPORT header row (flat) plus _action. Re-read the current row by REPORT_ID. Refuse with {'error': 'Only submitted reports can be approved or rejected'} unless its STATUS is 'Submitted' (treat the legacy value 'Pending' as submitted). Refuse with {'error': 'You cannot act on your own expense report'} when EMPLOYEE equals the logged-in user. Otherwise UPDATE EXPTRACK_EXPENSE_REPORT SET STATUS='Approved', APPROVER=<logged-in user>, APPROVAL_DATE=<current date/time>, APPROVER_COMMENTS=<payload APPROVER_COMMENTS>, PAYMENT_STATUS='Pending' (only when PAYMENT_STATUS is not already 'Paid'), CHG_DATE=<now>, CHG_USER=<logged-in user> WHERE REPORT_ID=<report id>. Then propagate to the lines: UPDATE EXPTRACK_EXPENSE SET STATUS='Approved', APPROVAL_STATUS='Approved', APPROVER=<logged-in user>, APPROVAL_DATE=<now>, CHG_DATE=<now>, CHG_USER=<logged-in user> WHERE EXPENSE_REPORT=<report id>. Return {'message': 'Report <REPORT_ID> approved and released to Finance Payment Processing.'}."
        },
        "confirmation": {
          "mode": "reconfirm",
          "message": "Approve expense report {form.REPORT_ID} for {form.EMPLOYEE} (amount {form.TOTAL_AMOUNT})?"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Only submitted reports actionable",
            "error_code": "APPR_NOT_SUBMITTED",
            "message": "Only submitted reports can be approved or rejected",
            "expression": "in_list({form.STATUS}, \"Submitted,Pending\")"
          },
          {
            "type": "expression",
            "name": "Cannot approve own report",
            "error_code": "APPR_SELF",
            "message": "You cannot act on your own expense report",
            "expression": "lower(trim({form.EMPLOYEE})) != lower(trim({var.login_user}))"
          }
        ]
      },
      {
        "name": "Reject",
        "handler": "message",
        "scope": "row",
        "visible_when": "in_list({form.STATUS}, \"Submitted,Pending\")",
        "business_logic": {
          "method": "reject_expense_report",
          "description": "Reject the submitted expense report",
          "spec": "Payload is the EXPTRACK_EXPENSE_REPORT header row (flat) plus _action. Re-read the current row by REPORT_ID. Refuse with {'error': 'Only submitted reports can be approved or rejected'} unless its STATUS is 'Submitted' (treat the legacy value 'Pending' as submitted). Refuse with {'error': 'You cannot act on your own expense report'} when EMPLOYEE equals the logged-in user. Refuse with {'error': 'Approver comments are mandatory when rejecting a report'} when APPROVER_COMMENTS is blank. Otherwise UPDATE EXPTRACK_EXPENSE_REPORT SET STATUS='Rejected', APPROVER=<logged-in user>, APPROVAL_DATE=<current date/time>, APPROVER_COMMENTS=<payload APPROVER_COMMENTS>, CHG_DATE=<now>, CHG_USER=<logged-in user> WHERE REPORT_ID=<report id>; leave PAYMENT_STATUS untouched so the report is never released to Finance. Then UPDATE EXPTRACK_EXPENSE SET STATUS='Rejected', APPROVAL_STATUS='Rejected', APPROVER=<logged-in user>, APPROVAL_DATE=<now>, APPROVER_COMMENTS=<comments>, CHG_DATE=<now>, CHG_USER=<logged-in user> WHERE EXPENSE_REPORT=<report id>. Return {'message': 'Report <REPORT_ID> rejected and returned to the employee.'}."
        },
        "confirmation": {
          "mode": "reconfirm",
          "message": "Reject expense report {form.REPORT_ID} for {form.EMPLOYEE}?"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Only submitted reports actionable",
            "error_code": "REJ_NOT_SUBMITTED",
            "message": "Only submitted reports can be approved or rejected",
            "expression": "in_list({form.STATUS}, \"Submitted,Pending\")"
          },
          {
            "type": "expression",
            "name": "Cannot reject own report",
            "error_code": "REJ_SELF",
            "message": "You cannot act on your own expense report",
            "expression": "lower(trim({form.EMPLOYEE})) != lower(trim({var.login_user}))"
          },
          {
            "type": "expression",
            "name": "Comments mandatory on reject",
            "error_code": "REJ_NO_COMMENTS",
            "message": "Approver comments are mandatory when rejecting a report",
            "expression": "not_empty({form.APPROVER_COMMENTS})"
          }
        ]
      }
    ],
