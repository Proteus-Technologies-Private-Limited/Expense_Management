    "follow_up_actions": [
      {
        "event": "on-edit",
        "name": "sync_expense_status",
        "business_logic": {
          "method": "sync_expense_status",
          "description": "Mirror the approval decision onto the expense status",
          "spec": "After the approver saves a decision on EXPTRACK_EXPENSE, if APPROVAL_STATUS is 'Approved' set STATUS='Approved'; if 'Rejected' set STATUS='Rejected'; leave STATUS='Pending' when APPROVAL_STATUS is still 'Pending'. Match the row on EXPENSE_REPORT + EXPENSE_ID and stamp CHG_DATE with the current date/time. Do not create or delete any expense record."
        }
      }
    ],
    "attach_docs": [
      "Receipt"
    ],
    "unit_test": {
      "sample": {
        "STATUS": "Pending",
        "APPROVAL_STATUS": "Pending",
        "CURRENCY": "INR",
        "CATEGORY": "@lookup",
        "PAYMENT_METHOD": "@lookup"
      },
      "note": "Manage Approval is a review queue over existing expense rows; the sample row uses a Pending expense with real master codes."
    }
  }
