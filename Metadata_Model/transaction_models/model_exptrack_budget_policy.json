          "validations": [
            {
              "type": "expression",
              "name": "Department required",
              "error_code": "BGT_DEPT_REQ",
              "message": "Department is mandatory.",
              "expression": "not_empty({form.DEPARTMENT})"
            },
            {
              "type": "expression",
              "name": "Tier name required",
              "error_code": "BGT_TIER_REQ",
              "message": "Tier Name is mandatory.",
              "expression": "not_empty({form.TIER_NAME})"
            },
            {
              "type": "expression",
              "name": "Status must be Active or Inactive",
              "error_code": "BGT_STATUS",
              "message": "Status must be Active or Inactive.",
              "expression": "in_list({form.STATUS}, \"A,I\")"
            }
