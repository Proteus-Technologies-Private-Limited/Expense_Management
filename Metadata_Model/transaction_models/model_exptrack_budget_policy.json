    ],
    "actions": [
      {
        "name": "Remove Document",
        "handler": "item_change",
        "scope": "row",
        "business_logic": {
          "method": "remove_budget_policy_document",
          "description": "Remove the uploaded budget policy document",
          "spec": "Clear the uploaded Budget Policy Document from the current EXPTRACK_BUDGET_POLICY record: UPDATE EXPTRACK_BUDGET_POLICY SET BUDGET_POLICY_DOCUMENT = NULL, CHG_DATE = current timestamp, CHG_USER = the acting user WHERE BUDGET_POLICY_ID = the payload's BUDGET_POLICY_ID. Return {\"updates\": {\"BUDGET_POLICY_DOCUMENT\": \"\"}} so the form field clears immediately. If the record carries no document, return {\"error\": \"No budget policy document is attached to this tier.\"}."
        },
        "visible_when": "not_empty({form.BUDGET_POLICY_DOCUMENT})",
        "validations": [
          {
            "type": "expression",
            "name": "Document must exist",
            "error_code": "BGT_NO_DOC",
            "message": "There is no budget policy document to remove on {form.BUDGET_POLICY_ID}.",
            "expression": "not_empty({form.BUDGET_POLICY_DOCUMENT})"
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Remove the budget policy document from {form.DEPARTMENT} / {form.TIER_NAME}?"
        }
      },
      {
        "name": "Delete",
        "handler": "system",
        "system_op": "delete",
        "scope": "row",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Delete budget policy tier {form.BUDGET_POLICY_ID} ({form.DEPARTMENT} / {form.TIER_NAME})?"
        }
      }
