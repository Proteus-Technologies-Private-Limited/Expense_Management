              ]
            }
          },
          "validations": [
            {
              "type": "expression",
              "name": "Only Submitted reports actionable",
              "error_code": "NOT_SUBMITTED",
              "message": "Only reports with status Submitted can be modified here.",
              "expression": "in_list({form.status}, \"Submitted,Approved,Rejected\")"
            }
          ],
          "search_default_filters": [
            {
              "column": "STATUS",
              "op": "=",
              "value": "Submitted"
            }
          ],
          "actions": [
            {
              "name": "Save",
              "handler": "system",
              "business_logic": {
                "method": "",
                "description": ""
              },
              "validations": [],
              "order": 1
            }
          ]
        }
      }
    ],
    "actions": [
      {
        "name": "add",
        "handler": "system",
        "system_op": "add",
        "validations": [
          {
            "type": "expression",
            "name": "Add not allowed",
            "message": "New expense reports cannot be created here. Reports are created only by submitting expenses on Manage Expense.",
            "expression": "false"
          }
        ]
      },
      {
        "name": "Approve",
        "handler": "message",
        "scope": "row",
        "visible_when": "{form.status} == \"Submitted\"",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Approve expense report {form.report_id}?"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Submitted",
            "error_code": "APR_NOT_SUBMITTED",
            "message": "Only reports with status Submitted can be approved (current status {form.status}).",
            "expression": "{form.status} == \"Submitted\""
          },
          {
            "type": "expression",
            "name": "Cannot approve own report",
            "error_code": "APR_SELF",
            "message": "You cannot act on a report you own.",
            "expression": "{form.employee} != {var.user_id}"
          }
        ],
        "business_logic": {
          "method": "approve_expense_report",
          "description": "Approve the report and propagate to linked expenses",
          "spec": "Given the current form payload (REPORT_ID, EMPLOYEE, STATUS), verify STATUS = 'Submitted' and EMPLOYEE is not the logged-in approver (defense in depth, in addition to the pre-action validations). UPDATE EXPTRACK_EXPENSE_REPORT SET STATUS='Approved', APPROVER=logged-in user short id, APPROVAL_DATE=current timestamp WHERE REPORT_ID = the report id AND STATUS='Submitted'. If no row was updated, return {\"error\": \"Report is no longer Submitted.\"}. Then UPDATE every EXPTRACK_EXPENSE row WHERE EXPENSE_REPORT = the report id SET STATUS='Approved', APPROVAL_STATUS='Approved', CHG_DATE=current timestamp. Insert an Activity Log entry (actor = logged-in user, action='Approved', affected REPORT_ID) if an activity log table/mechanism exists in the project. Return {\"message\": \"Report <REPORT_ID> approved.\"}."
        }
      },
      {
        "name": "Reject",
        "handler": "message",
        "scope": "row",
        "visible_when": "{form.status} == \"Submitted\"",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Reject expense report {form.report_id}?"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Submitted",
            "error_code": "REJ_NOT_SUBMITTED",
            "message": "Only reports with status Submitted can be rejected (current status {form.status}).",
            "expression": "{form.status} == \"Submitted\""
          },
          {
            "type": "expression",
            "name": "Cannot reject own report",
            "error_code": "REJ_SELF",
            "message": "You cannot act on a report you own.",
            "expression": "{form.employee} != {var.user_id}"
          },
          {
            "type": "expression",
            "name": "Comments mandatory on reject",
            "error_code": "REJ_COMMENTS_REQUIRED",
            "message": "Approver Comments are mandatory when rejecting a report.",
            "expression": "not_empty({form.approver_comments})"
          }
        ],
        "business_logic": {
          "method": "reject_expense_report",
          "description": "Reject the report and propagate to linked expenses",
          "spec": "Given the current form payload (REPORT_ID, EMPLOYEE, STATUS, APPROVER_COMMENTS), verify STATUS = 'Submitted', EMPLOYEE is not the logged-in approver, and APPROVER_COMMENTS is not blank (defense in depth, in addition to the pre-action validations). UPDATE EXPTRACK_EXPENSE_REPORT SET STATUS='Rejected', APPROVER=logged-in user short id, APPROVER_COMMENTS=the submitted comments, APPROVAL_DATE=current timestamp WHERE REPORT_ID = the report id AND STATUS='Submitted'. If no row was updated, return {\"error\": \"Report is no longer Submitted.\"}. Then UPDATE every EXPTRACK_EXPENSE row WHERE EXPENSE_REPORT = the report id SET STATUS='Rejected', APPROVAL_STATUS='Rejected', CHG_DATE=current timestamp. Insert an Activity Log entry (actor = logged-in user, action='Rejected', affected REPORT_ID) if an activity log table/mechanism exists in the project. Return {\"message\": \"Report <REPORT_ID> rejected.\"}."
        }
      },
      {
        "name": "View Receipt",
