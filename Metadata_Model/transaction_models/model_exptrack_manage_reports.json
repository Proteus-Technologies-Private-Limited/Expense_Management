            {
              "column": {
                "name": "current_status",
                "db_name": "CURRENT_STATUS",
                "table_name": "EXPTRACK_EXPENSE_REPORT",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Current Status",
                "descr": "Derived display status from STATUS + PAYMENT_STATUS: Draft; Submitted -> Pending Approval; Rejected; Cancelled; Approved+Pending -> Approved; Approved+Paid -> Payment Processed; otherwise the raw STATUS value.",
                "protect": "1",
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "current_status",
                      "expr": "iif({form.status} == \"Draft\", \"Draft\", iif({form.status} == \"Submitted\", \"Pending Approval\", iif({form.status} == \"Rejected\", \"Rejected\", iif({form.status} == \"Cancelled\", \"Cancelled\", iif({form.status} == \"Approved\", iif({form.payment_status} == \"Paid\", \"Payment Processed\", \"Approved\"), {form.status})))))"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Draft",
                      "color": "grey",
                      "icon": "\u25cf",
                      "label": "Draft"
                    },
                    {
                      "when": "Pending Approval",
                      "color": "yellow",
                      "icon": "\u25f7",
                      "label": "Pending Approval"
                    },
                    {
                      "when": "Approved",
                      "color": "blue",
                      "icon": "\u2713",
                      "label": "Approved"
                    },
                    {
                      "when": "Payment Processed",
                      "color": "green",
                      "icon": "\u2713",
                      "label": "Payment Processed"
                    },
                    {
                      "when": "Rejected",
                      "color": "red",
                      "icon": "\u2715",
                      "label": "Rejected"
                    },
                    {
                      "when": "Cancelled",
                      "color": "orange",
                      "icon": "\u2298",
                      "label": "Cancelled"
                    }
                  ],
                  "defaultColor": "grey"
                },
