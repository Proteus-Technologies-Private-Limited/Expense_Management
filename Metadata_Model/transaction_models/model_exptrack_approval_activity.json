      {
        "sql_model": {
          "form_title": "Approval Activity",
          "form_descr": "Read-only activity form over the EXISTING EXPTRACK_EXPENSE_REPORT data. The screen OPENS BLANK \u2014 nothing is fetched on entry; rows appear only after the user presses Search. The summary section embeds the Card visual exptrack_pending_approval_vouchers ('Total Pending Approval Vouchers' = COUNT of reports awaiting approval). The list is filtered to reports awaiting approval; no Add, Edit, Delete or approve/reject \u2014 decisions remain solely on exptrack_manage_expense.",
          "form_no": "1",
          "main_table": "EXPTRACK_EXPENSE_REPORT",
          "auto_fetch": false,
          "summary_visuals": [
            {
              "obj_name": "exptrack_pending_approval_vouchers",
              "obj_type": "V",
              "title": "Total Pending Approval Vouchers",
              "descr": "Card visual counting EXPTRACK_EXPENSE_REPORT rows awaiting approval (STATUS = 'Submitted' per the FRS)."
            }
          ],
          "list_view": {
            "extra_filters": [
              {
                "column": "STATUS",
                "op": "=",
                "value": "Submitted",
                "descr": "Only reports awaiting approval are listed. ASSUMPTION: the FRS names this state 'Submitted'; the current EXPTRACK_EXPENSE_REPORT.STATUS allowed-values list is [Pending, Approved, Rejected], so if 'Submitted' is not a legal value in the deployed design this filter must be changed to 'Pending' (the pending-approval state) \u2014 flagged as an open question."
              }
            ]
          },
