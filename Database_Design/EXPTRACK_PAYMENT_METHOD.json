{
  "table_name": "EXPTRACK_PAYMENT_METHOD",
  "table_description": "",
  "project": "Expense_Management",
  "columns": [
    {
      "column_name": "PAYMENT_METHOD_CODE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": true,
      "description": "Unique code identifying the payment method",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "PAYMENT_METHOD_NAME",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Name of the payment method (e.g. Cash, Corporate Card, Personal Card, Bank Transfer)",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "TYPE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Type of payment method",
      "sequence": 3,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "CASH",
          "label": "Cash"
        },
        {
          "value": "CARD",
          "label": "Card"
        },
        {
          "value": "BANK_TRANSFER",
          "label": "Bank Transfer"
        }
      ]
    },
    {
      "column_name": "CATEGORY_CODE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Expense category this payment method is linked to",
      "sequence": 4,
      "mandatory": true,
      "lookup": {
        "table": "EXPTRACK_EXPENSE_CATEGORY",
        "display_column": "CATEGORY_NAME",
        "value_column": "CATEGORY_CODE"
      }
    },
    {
      "column_name": "CATEGORY_NAME",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Auto-filled category name from the linked Expense Category master",
      "sequence": 5,
      "mandatory": true
    },
    {
      "column_name": "DESCRIPTION",
      "data_type": "VARCHAR",
      "size": "250",
      "key": false,
      "description": "Optional description of the payment method",
      "sequence": 6
    },
    {
      "column_name": "STATUS",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Active payment methods appear in the picker on Manage Expense; Inactive ones are hidden there but remain visible on historical records and Visuals",
      "sequence": 7,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "A",
          "label": "Active"
        },
        {
          "value": "I",
          "label": "Inactive"
        }
      ]
    },
    {
      "column_name": "CREATED_BY",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "User who created this payment method",
      "sequence": 8
    },
    {
      "column_name": "CREATED_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Date the payment method was created",
      "sequence": 9
    },
    {
      "column_name": "CHG_USER",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "User who last changed this payment method",
      "sequence": 10
    },
    {
      "column_name": "CHG_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Date the payment method was last changed",
      "sequence": 11
    }
  ]
}